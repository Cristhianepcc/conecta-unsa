# CONECTA UNSA — variables de entorno (copiar a .env y completar).
# NUNCA subir el .env real al repo (NFR-SEC-2).

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.railway.app

# --- Base de datos (Postgres) ---
# Local: ajusta usuario/host según tu instalación.
DATABASE_URL=postgres://project@localhost:5432/conecta_unsa

# --- Google OAuth (feature 02) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Resend (feature 08) ---
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=CONECTA UNSA <no-reply@conecta-unsa.pe>
